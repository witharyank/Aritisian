# Expo Managed Workflow Environment Variables
# Any variable prefixed with EXPO_PUBLIC_ will be available inline in the application code.

# Gemini API Key for AI features (Prototype only)
# IMPORTANT: In a production app, do NOT bundle this key. The mobile app should call your secure backend, which then calls Gemini.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
